{
  "name": "dbtlr-bootstrap",
  "version": "0.1.0",
  "description": "A fast CLI tool for bootstrapping new applications with modern tooling",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dbtlr-bootstrap": "./bin/cli.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean",
    "dev": "tsdown src/index.ts --watch",
    "start": "tsx src/cli/main.ts",
    "cli": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "lint": "oxlint --tsconfig tsconfig.json src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "quality": "pnpm run typecheck && pnpm run format:check && pnpm run lint && pnpm run test",
    "prepublishOnly": "pnpm run quality && pnpm run build"
  },
  "keywords": [
    "cli",
    "bootstrap",
    "scaffolding",
    "generator",
    "typescript",
    "tooling"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "boxen": "^8.0.1",
    "c12": "^3.3.3",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "consola": "^3.4.2",
    "debug": "^4.4.3",
    "enquirer": "^2.4.1",
    "listr2": "^10.0.0",
    "ora": "^9.0.0",
    "pathe": "^2.0.3",
    "std-env": "^3.10.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^25.0.9",
    "@vitest/ui": "^4.0.17",
    "oxc-transform": "^0.108.0",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.39.0",
    "tsdown": "0.20.0-beta.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
